MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_SHAREPOINT_SITE_ID=
MICROSOFT_SHAREPOINT_DRIVE_ID=
MICROSOFT_SHAREPOINT_FOLDER_ID=
